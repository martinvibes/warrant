{
  "name": "warrant",
  "version": "0.1.0",
  "private": true,
  "description": "An agent with its own wallet that discovers and buys what it needs, per request, on Hedera. Spending limits are enforced on chain.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "tsx src/agent/run.ts",
    "build:web": "npm --prefix frontend install && npm --prefix frontend run build",
    "dev:web": "npm --prefix frontend run dev",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url hedera_testnet --broadcast --skip-simulation",
    "fund": "tsx scripts/fund.ts",
    "demo:chain": "./scripts/local-chain.sh",
    "associate": "tsx scripts/associate.ts",
    "new-account": "tsx scripts/new-account.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "tsx scripts/verify-receipt.ts",
    "privy:setup": "tsx scripts/privy-setup.ts",
    "privy:policy": "tsx scripts/privy-policy.ts",
    "privy:check": "tsx scripts/privy-check.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0",
    "@x402/core": "2.25.0",
    "@x402/express": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/hedera": "2.25.0",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "resend": "^4.1.1",
    "viem": "^2.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
