{
  "name": "warrant",
  "version": "0.1.0",
  "private": true,
  "description": "Scoped spending authority for autonomous agents. Agents buy real resources; humans sign the limits.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "tsx src/agent/buy.ts",
    "sign": "tsx scripts/sign-warrant.ts",
    "revoke": "tsx scripts/revoke-warrant.ts"
  },
  "dependencies": {
    "@x402/core": "2.25.0",
    "@x402/express": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/hedera": "2.25.0",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "resend": "^4.1.1",
    "viem": "^2.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
