# ---- Hedera (testnet) ----
# Create a testnet account at https://portal.hedera.com — ECDSA keys.
HEDERA_NETWORK=hedera:testnet
# Seller account that receives payment (operator of this service).
HEDERA_ACCOUNT_ID=0.0.xxxxxx
HEDERA_PRIVATE_KEY=
# Buyer/agent account used by the demo agent.
AGENT_HEDERA_ACCOUNT_ID=0.0.xxxxxx
AGENT_HEDERA_PRIVATE_KEY=

# x402 facilitator (Blocky402). Open access, no API key.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# ---- Warrant signing ----
# secp256k1 key of the human who signs warrants (EIP-712).
OWNER_PRIVATE_KEY=
# Address allowed to issue warrants. Derived from OWNER_PRIVATE_KEY if unset.
OWNER_ADDRESS=

# ---- Upstream resources ----
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=agent@example.com

# ---- Privy (agent wallet + policy) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=

PORT=8090
DATA_DIR=./data
