# --- Hedera -----------------------------------------------------------------
# The account this service is paid into, and that pays for Hedera file writes.
# Get one at portal.hedera.com, fund it with testnet HBAR and USDC 0.0.429274.
HEDERA_NETWORK=hedera:testnet
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=

# Blocky402 sponsors the network fee, so a paying agent needs USDC and no HBAR.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- Contracts --------------------------------------------------------------
# Filled in by `npm run contracts:deploy`.
IDENTITY_CONTRACT=
MARKET_CONTRACT=
TREASURY_CONTRACT=

# EVM key the service signs contract writes with, so a buyer never needs HBAR.
SERVICE_PRIVATE_KEY=
# EVM key that owns the treasury and sets limits. Used by `npm run fund`.
OWNER_PRIVATE_KEY=

# --- The agent --------------------------------------------------------------
# A second Hedera account, so the buyer and the seller are not the same party.
AGENT_HEDERA_ACCOUNT_ID=0.0.xxxxx
AGENT_HEDERA_PRIVATE_KEY=
# Its EVM key, for drawing from the treasury and for sealed mail. When Privy
# holds the spending key this one is used only for sealed mail, because a
# custodial signer will sign for you but will never hand over the scalar an
# ECIES decrypt needs.
AGENT_EVM_PRIVATE_KEY=
# Override if the messaging key should be separate from the EVM key above.
# AGENT_MESSAGING_KEY=

# --- Providers --------------------------------------------------------------
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_DOMAIN=
EMAIL_WEBHOOK_SECRET=
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# --- Privy ------------------------------------------------------------------
# Where the agent's signing key lives. From dashboard.privy.io; the app secret
# is shown once, at creation.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The authorization key. Generate it locally — Privy must never see the private
# half, which is the whole point of the arrangement:
#
#   openssl ecparam -genkey -name prime256v1 -noout -out key.pem
#   openssl pkcs8 -topk8 -nocrypt -in key.pem -out key-pkcs8.pem
#
# then set this to "wallet-auth:" followed by the base64 body of key-pkcs8.pem
# (the lines between BEGIN and END, joined).
PRIVY_AUTH_PRIVATE_KEY=

# Everything below is written by `npm run privy:setup` and `npm run privy:policy`.
# Leave them blank on a fresh checkout.
PRIVY_AUTH_KEY_ID=
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
PRIVY_WALLET_PUBLIC_KEY=
PRIVY_POLICY_ID=
# The Hedera account that wallet's key controls, and the account the agent pays
# from once Privy holds its key.
AGENT_PRIVY_ACCOUNT_ID=

# --- Service ----------------------------------------------------------------
PORT=8090
DATA_DIR=./data
PUBLIC_URL=http://localhost:8090

# --- Prices, in atomic USDC (6 dp). Optional; sensible defaults are built in.
# PRICE_INFERENCE=20000
# PRICE_EMAIL_INBOX=1000000
